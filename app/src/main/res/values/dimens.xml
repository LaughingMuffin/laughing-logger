<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- These values are read with getDimension() and applied via
         setTextSize(COMPLEX_UNIT_SP, ...) in LogLineAdapter, so the raw
         number is treated as sp at the call site. Using "sp" units here
         would cause the value to be density-scaled twice. -->
    <dimen name="text_size_xsmall" tools:ignore="PxUsage">8px</dimen>
    <dimen name="text_size_small" tools:ignore="PxUsage">10px</dimen>
    <dimen name="text_size_medium" tools:ignore="PxUsage">12px</dimen>
    <dimen name="text_size_large" tools:ignore="PxUsage">14px</dimen>
    <dimen name="text_size_xlarge" tools:ignore="PxUsage">16px</dimen>

    <dimen name="log_level_width">15dp</dimen>
    <dimen name="tag_width">70dp</dimen>
    <dimen name="pid_width">85dp</dimen>
</resources>
